# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Community Cloud > App settings > Secrets. Never commit real values.

# Shared storage for contributors' files (Supabase). Leave out to use a
# local folder, which Streamlit Cloud wipes on every restart.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_KEY = "service-role key (server side only)"
SUPABASE_BUCKET = "uploads"

# Password for the curator review page.
CURATOR_PASSWORD = "change-me"

# Password for the whole app. Leave it out and anyone with the link can look and
# contribute; set it and nothing is shown until it is typed.
APP_PASSWORD = "share-this-with-the-group"
